# ============================================================================
# HelloBuddy — Environment Variables
# Copy this file to .env.local for local development.
# Never commit real secrets.
# ============================================================================

# --- Supabase -----------------------------------------------------------
# Found in Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is ONLY used in trusted server contexts (never sent to the client).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google OAuth (optional) ---------------------------------------------
# If both are set, HelloBuddy shows a "Continue with Google" button.
# Configure this provider inside Supabase Auth > Providers > Google as well.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- AI Provider ----------------------------------------------------------
# Choose ONE provider: "openai" | "anthropic" | "gemini" | "demo"
# "demo" requires no key and returns clearly-labeled canned responses so the
# app is fully explorable without any AI credentials.
AI_PROVIDER=demo

# Only the key matching AI_PROVIDER above is required.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- App configuration ------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HelloBuddy

# Daily free-tier AI message allowance
FREE_PLAN_DAILY_MESSAGE_LIMIT=30
